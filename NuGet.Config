<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Локальный источник пакетов для offline-сборки.
      Путь относительный — вычисляется от расположения самого NuGet.Config
      (NuGet.Config всегда ищется в корне репозитория и выше).
    -->
    <add key="LocalPackages" value="LocalPackages" />
  </packageSources>
</configuration>