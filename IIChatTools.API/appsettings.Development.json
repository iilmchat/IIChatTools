{
  "Database": {
    "Provider": "Sqlite",
    "SqlServerConnectionString": "Server=(localdb)\\mssqllocaldb;Database=IIChatTools_Dev;Trusted_Connection=True;MultipleActiveResultSets=true",
    "SqliteConnectionString": "Data Source=Data/iichattools-dev.db"
  },
   "HealthChecks": {
    "LmStudio": {
      "Enabled": true,
      "TimeoutSeconds": 3
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "PerUser": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 5
    },
    "ToolsExecute": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Metrics": {
    "Enabled": true
  },     
  "Audit": {
    "ToDatabase": true,
    "ToFile": true
  },
  "Jwt": {
    "Issuer": "IIChatTools",
    "Audience": "IIChatToolsClients",
    "Key": "DEV_ONLY_SECRET_KEY_32_CHARS_MINIMUM_LENGTH_1234",
    "ExpirationMinutes": 480
  },
  "Workspace": {
    "RootPath": "%USERPROFILE%\\IIChatToolsWorkspace",
    "MaxFileSizeBytes": 10485760,
    "MaxCommandOutputBytes": 1048576
  },
  "Security": {
    "EnableCodeExecution": true,
    "EnableBrowserAutomation": true,
    "EnableShellCommands": true,
    "ApprovalExpirationMinutes": 5,
    "GitTimeoutSeconds": 60,
    "GhTimeoutSeconds": 90,
    "BrowserHeadless": true,
    "MaxBrowserSessionsPerUser": 3,
    "BrowserSessionTtlMinutes": 15,
    "BrowserPageTimeoutSeconds": 30
  },
  "Tools": {
    "RequireApprovalByDefault": true,
    "Whitelist": []
  },
  "LmStudio": {
    "BaseUrl": "http://localhost:8034",
    "Model": "qwen/qwen3-4b-2507",
    "MaxTokens": 4096,
    "Temperature": 0.2,
    "Profiles": {
      "SubAgent": {         
        "Model": "qwen/qwen3-4b-2507",
        "MaxTokens": 4096,
        "Temperature": 0.2,
        "SupportsToolCalling": true,
        "DefaultAllowedTools": [
            "list_directory",
            "read_file",
            "find_files",
            "get_file_metadata",
            "save_file",
            "make_directory",
            "git_status",
            "git_diff",
            "git_log",
            "execute_command",
            "web_search",
            "fetch_web_content"
        ]  
      },
      "Planner": { 
        "Model": "gemma-4-12b-coder-fable5-composer2.5-v1",
        "MaxTokens": 8192,
        "Temperature": 0.3,
        "SupportsToolCalling": false,
        "Reasoning": true
      },
      "Fast": {
        "Model": "qwen2.5-3b-instruct",
        "MaxTokens": 1024,
        "Temperature": 0.1,
        "SupportsToolCalling": false        
      }
    }
  },
  "SubAgent": {
    "DefaultMaxSteps": 10,
    "MaxStepsLimit": 30,
    "SystemPrompt": "Ты — автономный вторичный агент IIChatTools. Твоя задача — выполнить порученную работу, используя доступные инструменты. Действуй пошагово, проверяй результаты и заверши работу финальным ответом. Отвечай на русском языке. У тебя максимум {{maxSteps}} шагов.",
    "ReviewerSystemPrompt": "Ты — критичный рецензент. Проверь финальный ответ другого агента на полноту и корректность. Если всё в порядке — напиши 'OK' и краткое подтверждение. Если есть замечания — перечисли их по пунктам. Отвечай на русском языке."
  },
  "Browser": {
    "ExecutablePath": "",
    "Headless": true,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "ProxyServer": "CHANGE_ME_VIA_USER_SECRETS",
    "ProxyUsername": "CHANGE_ME_VIA_USER_SECRETS",
    "ProxyPassword": "CHANGE_ME_VIA_USER_SECRETS",
    "IgnoreCertificateErrors": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}