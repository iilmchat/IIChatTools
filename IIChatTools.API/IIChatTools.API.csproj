<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IIChatTools.API</RootNamespace>
    <AssemblyName>IIChatTools.API</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>iichattools-api-secrets-2026</UserSecretsId>
    <Description>Веб-приложение и API IIChatTools v1.1.0.</Description>

    <!-- Настройки компиляции Razor (MSBuild-свойства, а не элементы!) -->
    <MvcRazorCompileOnPublish>true</MvcRazorCompileOnPublish>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ссылки на слои -->
    <ProjectReference Include="..\IIChatTools.Data\IIChatTools.Data.csproj" />
    <ProjectReference Include="..\IIChatTools.Services\IIChatTools.Services.csproj" />
  </ItemGroup>

  <!--
    v1.12.0 (KI-131, Ф6.7): overlay — отдельный WinExe (net10.0-windows, WPF),
    Windows-only. НЕ включён в .sln (иначе Linux CI/Docker падают:
    NETSDK1100 / MSB3202 — WPF требует Windows SDK, которого на Linux нет).
    Сборка overlay — через Target ниже, только на Windows.
  -->
  <PropertyGroup>
    <VisionOverlayProjectPath>$(MSBuildThisFileDirectory)..\IIChatTools.VisionOverlay\IIChatTools.VisionOverlay.csproj</VisionOverlayProjectPath>
    <VisionOverlayOutputPath>$(MSBuildThisFileDirectory)..\IIChatTools.VisionOverlay\bin\$(Configuration)\net10.0-windows</VisionOverlayOutputPath>
  </PropertyGroup>

  <!--
    Windows: собрать overlay (если exe отсутствует) и скопировать содержимое
    bin в $(OutDir)VisionOverlay/. Linux/macOS: Target пропускается — overlay
    там не работает (WPF + Win32 SendInput).
  -->
  <Target Name="BuildAndCopyVisionOverlay"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'">
    <MSBuild Projects="$(VisionOverlayProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             Condition="!Exists('$(VisionOverlayOutputPath)\IIChatTools.VisionOverlay.exe')" />

    <ItemGroup>
      <VisionOverlayFiles Include="$(VisionOverlayOutputPath)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(VisionOverlayFiles)"
          DestinationFiles="@(VisionOverlayFiles->'$(OutDir)VisionOverlay\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(VisionOverlayFiles)' != ''" />
  </Target>

  <ItemGroup>
    <!-- JWT аутентификация -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftAspNetCoreVersion)" />

    <!-- MVC + Razor + локализация -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="$(MicrosoftAspNetCoreVersion)" />

    <!-- EF Core Design для миграций из CLI -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFCoreVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Провайдеры БД -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkSqliteVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EFCoreVersion)" />
    
    <!--
      KI-022: явное переопределение транзитивной зависимости SQLitePCLRaw
      для устранения GHSA-2m69-gcr7-jv3q (High).
      EF Core Sqlite тянет уязвимую 2.1.11 → перекрываем на 2.1.13.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SQLitePCLRawVersion)" />    

    <!-- Prometheus метрики (exporter + HTTP-middleware).
         GA-версия 8.2.1 — совместима с .NET 10. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файлы локализации (.resx) -->
    <EmbeddedResource Update="Resources\SharedResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SharedResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\SharedResources.ru.resx">
      <DependentUpon>SharedResources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>