@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Админка"];
}

<div class="container mt-4">
    <h1 class="mb-3">@Localizer["Администрирование"]</h1>

    <ul class="nav nav-tabs" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-users" data-bs-toggle="tab" data-bs-target="#pane-users" type="button" role="tab">
                @Localizer["Управление пользователями"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-settings" data-bs-toggle="tab" data-bs-target="#pane-settings" type="button" role="tab">
                @Localizer["Управление настройками"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-whitelist" data-bs-toggle="tab" data-bs-target="#pane-whitelist" type="button" role="tab">
                @Localizer["Белый список инструментов"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-audit" data-bs-toggle="tab" data-bs-target="#pane-audit" type="button" role="tab">
                @Localizer["Просмотр аудита"]
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-3">
        <div class="tab-pane fade show active" id="pane-users" role="tabpanel">
            <p class="text-muted small">@Localizer["Загрузка"]…</p>
        </div>
        <div class="tab-pane fade" id="pane-settings" role="tabpanel">
            <p class="text-muted small">@Localizer["Загрузка"]…</p>
        </div>
        <div class="tab-pane fade" id="pane-whitelist" role="tabpanel">
            <p class="text-muted small">@Localizer["Загрузка"]…</p>
        </div>
        <div class="tab-pane fade" id="pane-audit" role="tabpanel">
            <p class="text-muted small">@Localizer["Загрузка"]…</p>
        </div>
    </div>
</div>