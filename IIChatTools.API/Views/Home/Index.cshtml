@using Microsoft.Extensions.Localization
@using IIChatTools.API.Resources
@using IIChatTools.API

@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Главная"];
}

<div class="container mt-4">
    <!-- KI-081: hero-логотип -->
    <div class="text-center mb-4">
        <img src="~/images/logo-full.svg"
             alt="IIRuChating — IIChatTools"
             class="home-hero-logo"
             asp-append-version="true" />
    </div>

    <h1 class="mb-3 text-center">@string.Format(Localizer["WelcomeTitle"].Value, AppVersion.Current)</h1>
    <p class="text-muted text-center">@Localizer["Управляйте инструментами, пользователями и настройками."]</p>

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Статус системы"]</h5>
                    <p class="card-text small text-muted">@Localizer["Проверка состояния сервера, зависимостей и статистики."]</p>
                    <a href="/status" class="btn btn-outline-primary btn-sm">@Localizer["Перейти"]</a>
                </div>
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@Localizer["Администрирование"]</h5>
                        <p class="card-text small text-muted">@Localizer["Управление пользователями, настройками и белым списком инструментов."]</p>
                        <a href="/admin" class="btn btn-outline-primary btn-sm">@Localizer["Перейти"]</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@Localizer["Тестирование"]</h5>
                        <p class="card-text small text-muted">@Localizer["Ручной вызов инструментов для отладки."]</p>
                        <a href="/test" class="btn btn-outline-primary btn-sm">@Localizer["Перейти"]</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info mt-4">
            @Localizer["Первый зарегистрированный пользователь получает роль администратора."]
            <a asp-controller="Auth" asp-action="Register" class="alert-link">@Localizer["Зарегистрироваться"]</a>
        </div>
    }
</div>