@using Microsoft.Extensions.Localization
@using IIChatTools.API.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["ProfileTitle"];
}

<div class="container mt-4">
    <h1 class="mb-4">@Localizer["ProfileTitle"]</h1>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">@Localizer["ProfileRetentionSection"]</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small" id="profile-global-hint">
                        @Localizer["ProfileGlobalHint"]
                    </p>

                    <div class="mb-3">
                        <label for="profile-retention-days" class="form-label">
                            @Localizer["ProfileRetentionDays"]
                        </label>
                        <input type="number"
                               id="profile-retention-days"
                               class="form-control"
                               min="1"
                               placeholder="@Localizer["ProfileRetentionDaysPlaceholder"]" />
                        <div class="form-text">@Localizer["ProfileRetentionDaysHint"]</div>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox"
                               id="profile-do-not-delete"
                               class="form-check-input" />
                        <label class="form-check-label" for="profile-do-not-delete">
                            @Localizer["ProfileDoNotDelete"]
                        </label>
                        <div class="form-text">@Localizer["ProfileDoNotDeleteHint"]</div>
                    </div>

                    <button id="btn-save-profile-settings" type="button" class="btn btn-primary">
                        @Localizer["ProfileSave"]
                    </button>

                    <span id="profile-save-status" class="ms-2 small"></span>
                </div>
            </div>

            <!-- v1.5.0 (KI-083, Шаг 7C.2): Workspace Index (opt-in, per-user) -->
            <div class="card shadow-sm mt-3"
                 id="profile-workspace-card"
                 data-label-status-disabled="@Localizer["ProfileWorkspaceStatusDisabled"]"
                 data-label-status-enabled="@Localizer["ProfileWorkspaceStatusEnabled"]"
                 data-label-status-indexing="@Localizer["ProfileWorkspaceStatusIndexing"]"
                 data-label-progress="@Localizer["ProfileWorkspaceProgress"]"
                 data-label-error="@Localizer["ProfileWorkspaceLastErrorPrefix"]"
                 data-label-enable-success="@Localizer["ProfileWorkspaceEnableSuccess"]"
                 data-label-disable-success="@Localizer["ProfileWorkspaceDisableSuccess"]"
                 data-label-disable-confirm="@Localizer["ProfileWorkspaceDisableConfirm"]"
                 data-label-reindex-success="@Localizer["ProfileWorkspaceReindexSuccess"]">
                <div class="card-header">
                    <h5 class="mb-0">@Localizer["ProfileWorkspaceSection"]</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input type="checkbox"
                               id="profile-workspace-enable"
                               class="form-check-input" />
                        <label class="form-check-label" for="profile-workspace-enable">
                            @Localizer["ProfileWorkspaceEnable"]
                        </label>
                        <div class="form-text">@Localizer["ProfileWorkspaceEnableHint"]</div>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted small">@Localizer["ProfileWorkspaceStatusLabel"]:</span>
                        <strong id="profile-workspace-status" class="ms-1">—</strong>
                    </div>

                    <div id="profile-workspace-progress-wrap" class="mb-3" hidden>
                        <div class="progress profile-workspace-progress" role="progressbar"
                             aria-label="@Localizer["ProfileWorkspaceStatusIndexing"]"
                             aria-valuemin="0" aria-valuemax="100">
                            <div id="profile-workspace-progress-bar"
                                 class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width: 0%;"></div>
                        </div>
                        <div class="small text-muted mt-1" id="profile-workspace-progress-text"></div>
                    </div>

                    <div id="profile-workspace-error"
                         class="alert alert-warning py-1 px-2 small mb-2"
                         hidden></div>

                    <button id="btn-profile-workspace-reindex"
                            type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled>
                        @Localizer["ProfileWorkspaceReindex"]
                    </button>
                </div>
            </div>

            <!-- v1.13.1-fix8 (KI-145): выбор микрофона для голосового ввода -->
            <div class="card shadow-sm mt-3"
                 id="profile-audio-card"
                 data-label-device-default="@Localizer["ProfileAudioDefaultOption"]"
                 data-label-test-recording="@Localizer["ProfileAudioTestRecording"]"
                 data-label-test-success="@Localizer["ProfileAudioTestSuccess"]"
                 data-label-test-failed="@Localizer["ProfileAudioTestFailed"]"
                 data-label-save-success="@Localizer["ProfileAudioSaveSuccess"]"
                 data-label-save-error="@Localizer["ProfileAudioSaveError"]"
                 data-label-permission-denied="@Localizer["ProfileAudioPermissionDenied"]"
                 data-label-permission-granted="@Localizer["ProfileAudioPermissionGranted"]">
                <div class="card-header">
                    <h5 class="mb-0">🎤 @Localizer["ProfileAudioSection"]</h5>
                </div>
                <div class="card-body">
                    <!-- Состояние A: разрешение не выдано -->
                    <div id="profile-audio-permission-state">
                        <p class="text-muted small mb-2">@Localizer["ProfileAudioHint"]</p>
                        <p class="text-muted small mb-3">@Localizer["ProfileAudioPermissionHint"]</p>
                        <button id="btn-profile-audio-request-permission"
                                type="button"
                                class="btn btn-primary">
                            @Localizer["ProfileAudioRequestPermission"]
                        </button>
                        <span id="profile-audio-permission-status" class="ms-2 small"></span>
                    </div>

                    <!-- Состояние B: разрешение выдано -->
                    <div id="profile-audio-device-state" hidden>
                        <p class="text-muted small mb-3">@Localizer["ProfileAudioHint"]</p>

                        <div class="mb-3">
                            <label for="profile-audio-device" class="form-label">
                                @Localizer["ProfileAudioDeviceLabel"]
                            </label>
                            <select id="profile-audio-device" class="form-select"></select>
                        </div>

                        <div class="mb-3">
                            <button id="btn-profile-audio-test"
                                    type="button"
                                    class="btn btn-outline-secondary btn-sm">
                                @Localizer["ProfileAudioTestButton"]
                            </button>
                            <span id="profile-audio-test-result" class="ms-2 small"></span>
                        </div>

                        <div class="alert alert-info py-2 px-3 small mb-0">
                            ⓘ @Localizer["ProfileAudioVirtualWarning"]
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { initProfilePage } from '/js/modules/profile.js';
        import { initProfileWorkspaceCard } from '/js/modules/profile-workspace.js';
        import { initProfileAudioCard } from '/js/modules/profile-audio.js';
        initProfilePage();
        initProfileWorkspaceCard();
        initProfileAudioCard();
    </script>
}