@using Microsoft.Extensions.Localization
@using IIChatTools.API.Resources
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Чат"];
}

<div class="chat-container">
    <!-- ===== Sidebar: список чатов ===== -->
    <aside class="chat-sidebar">
        <div class="chat-sidebar-header">
            <button id="btn-new-chat" type="button" class="btn btn-primary btn-sm w-100">
                + @Localizer["Новый чат"]
            </button>
        </div>

        <!-- Фаза 2.2.3: поиск по названию чата (клиентский фильтр) -->
        <div class="chat-sidebar-search">
            <input id="chat-search"
                   type="search"
                   autocomplete="off"
                   placeholder="@Localizer["ChatSearchPlaceholder"]"
                   data-label-no-results="@Localizer["ChatSearchNoResults"]" />
        </div>

        <div id="chat-list" class="chat-list">
            <div class="text-muted text-center p-3 small">
                @Localizer["Загрузка"]…
            </div>
        </div>
    </aside>

    <!-- ===== Основная область: сообщения + input ===== -->
    <main class="chat-main">
        <!-- Заголовок чата (скрыт, пока чат не выбран) -->
        <div id="chat-header" class="chat-header d-none">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div class="text-truncate flex-grow-1">
                    <h6 id="chat-title" class="mb-1 text-truncate">—</h6>
                    <select id="chat-model-select"
                            class="chat-model-select"
                            title="@Localizer["ChatModelLabel"]"
                            data-label-default="@Localizer["ChatModelSuffixDefault"]"
                            data-label-unavailable="@Localizer["ChatModelSuffixUnavailable"]"
                            data-label-empty="@Localizer["ChatModelEmpty"]"></select>
                </div>
                <button id="btn-delete-chat" type="button"
                        class="btn btn-outline-danger btn-sm flex-shrink-0"
                        title="@Localizer["Удалить чат"]">
                    🗑
                </button>
            </div>
        </div>

        <!-- Лента сообщений -->
        <div id="chat-messages" class="chat-messages">
            <div id="chat-empty" class="chat-empty-state">
                <div class="text-muted text-center">
                    <div style="font-size: 3rem;">💬</div>
                    <p class="mb-0">@Localizer["Выберите чат или создайте новый"]</p>
                </div>
            </div>
        </div>

        <!-- Поле ввода -->
        <div class="chat-input">
            <div class="input-group">
                <textarea id="chat-input" class="form-control" rows="1"
                          placeholder="@Localizer["Введите сообщение…"]"
                          disabled></textarea>
                <button id="btn-stop" type="button" class="btn btn-outline-danger" hidden
                        title="@Localizer["Остановить"]" aria-label="@Localizer["Остановить"]">
                    ⏹
                </button>
                <button id="btn-send" type="button" class="btn btn-primary" disabled>
                    @Localizer["Отправить"]
                </button>
            </div>
        </div>
    </main>
</div>

<!-- Модалка подтверждения tool call (используется с Фазы 1.7) -->
<partial name="_ApprovalModal" />

@section Styles {
    <!-- highlight.js тема (перед chat.css, чтобы наши стили переопределили) -->
    <link rel="stylesheet" href="~/lib/highlight/github.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

@section Scripts {
    <!-- Markdown + sanitize + highlight (UMD, локально). -->
    <!-- Глобальные: window.marked / window.DOMPurify / window.hljs. -->
    <script src="~/lib/marked/marked.min.js" asp-append-version="true"></script>
    <script src="~/lib/dompurify/purify.min.js" asp-append-version="true"></script>
    <script src="~/lib/highlight/highlight.min.js" asp-append-version="true"></script>

    <script type="module">
        import { initChatPage } from '/js/modules/chat.js';
        initChatPage();
    </script>
}