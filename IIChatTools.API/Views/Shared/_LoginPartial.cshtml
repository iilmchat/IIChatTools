@using Microsoft.AspNetCore.Identity
@using IIChatTools.Data.Entities
@using Microsoft.AspNetCore.Mvc.Localization
@using IIChatTools.API.Resources
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResources> Localizer



<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.FullName ?? User.Identity?.Name;

        <li class="nav-item">
            <a class="nav-link text-dark" href="/profile" title="@Localizer["ProfileMenu"]">
                @displayName
            </a>
        </li>
        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-dark">
                    @Localizer["Выход"]
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register">@Localizer["Регистрация"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">@Localizer["Вход"]</a>
        </li>
    }
</ul>