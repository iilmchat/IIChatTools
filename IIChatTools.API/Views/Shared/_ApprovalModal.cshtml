@using Microsoft.Extensions.Localization
@using IIChatTools.API.Resources
@inject IStringLocalizer<SharedResources> Localizer

<div class="modal fade" id="approvalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Запрос на выполнение действия"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">@Localizer["Инструмент требует подтверждения перед выполнением."]</p>
                <dl class="row">
                    <dt class="col-sm-3">@Localizer["Инструмент"]</dt>
                    <dd class="col-sm-9" id="approval-tool-name">—</dd>
                    <dt class="col-sm-3">@Localizer["Параметры вызова"]</dt>
                    <dd class="col-sm-9">
                        <div id="approval-params"
                             class="chat-approval-params"
                             data-label-task="@Localizer["ApprovalParamTask"]"
                             data-label-context="@Localizer["ApprovalParamContext"]"
                             data-label-to="@Localizer["ApprovalParamTo"]"
                             data-label-cc="@Localizer["ApprovalParamCc"]"
                             data-label-subject="@Localizer["ApprovalParamSubject"]"
                             data-label-body="@Localizer["ApprovalParamBody"]"
                             data-label-action="@Localizer["ApprovalParamAction"]"
                             data-label-target="@Localizer["ApprovalParamTarget"]"
                             data-label-sql="@Localizer["ApprovalParamSql"]"
                             data-label-code="@Localizer["ApprovalParamCode"]"
                             data-label-language="@Localizer["ApprovalParamLanguage"]"
                             data-label-parallel="@Localizer["ApprovalParamParallel"]"
                             data-label-max-subtasks="@Localizer["ApprovalParamMaxSubtasks"]"
                             data-label-other-fields="@Localizer["ApprovalParamOtherFields"]"
                             data-label-raw-json="@Localizer["ApprovalParamRawJson"]">—</div>
                    </dd>
                    <dt class="col-sm-3">@Localizer["Подтверждение"]</dt>
                    <dd class="col-sm-9">
                        <small class="text-muted" id="approval-countdown">—</small>
                    </dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" id="approval-reject">@Localizer["Отклонить"]</button>
                <button type="button" class="btn btn-success" id="approval-approve">@Localizer["Подтвердить"]</button>
            </div>
        </div>
    </div>
</div>