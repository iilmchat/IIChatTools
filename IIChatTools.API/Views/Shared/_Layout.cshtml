@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using IIChatTools.API
@using IIChatTools.API.Resources
@inject IStringLocalizer<SharedResources> Localizer
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — IIChatTools</title>

    <!-- KI-122 (B2): anti-FOUC — устанавливаем тему ДО первого paint.
         Синхронный inline-скрипт (без type="module" — модули грузятся асинхронно).
         Алгоритм дублирует theme.js/getTheme() — см. комментарий в модуле. -->
    <script>
        (function () {
            try {
                var valid = ["light", "dark", "dimmed", "solarized-light", "high-contrast"];
                var t = localStorage.getItem("theme");
                if (!t || valid.indexOf(t) === -1) {
                    t = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)
                        ? "dark"
                        : "light";
                }
                document.documentElement.setAttribute("data-bs-theme", t);
            } catch (e) {
                /* no-op: при ошибке остаётся data-bs-theme="light" из <html> */
            }
        })();
    </script>

    <!-- KI-081: favicon (файлы от realfavicongenerator в wwwroot/images/) -->
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />

    <!-- Bootstrap 5 CSS (локально) -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- Локальные стили -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Стили конкретной страницы (опционально) -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-icon.svg"
                         alt="@AppVersion.ProductName"
                         class="navbar-brand-logo"
                         asp-append-version="true" />
                    <span>
                        <strong>@AppVersion.ProductName</strong>
                        <span class="text-muted small">v@(AppVersion.Current)</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">@Localizer["Главная"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/chat">@Localizer["Чат"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Status">@Localizer["Статус"]</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/profile">@Localizer["ProfileMenu"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Admin">@Localizer["Админка"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Test">@Localizer["Тест"]</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <!-- KI-122 (B3): переключатель темы оформления (5 тем).
                             Значения value — из theme.js (getAvailableThemes()).
                             Синхронизация с localStorage / системной темой —
                             в initThemeSelect() (theme.js). -->
                        <li class="nav-item d-flex align-items-center me-2">
                            <select id="theme-select"
                                    class="navbar-theme-select"
                                    title="@Localizer["ThemeSelectTitle"]"
                                    aria-label="@Localizer["ThemeSelectTitle"]">
                                <option value="light">@Localizer["ThemeLight"]</option>
                                <option value="dark">@Localizer["ThemeDark"]</option>
                                <option value="dimmed">@Localizer["ThemeDimmed"]</option>
                                <option value="solarized-light">@Localizer["ThemeSolarizedLight"]</option>
                                <option value="high-contrast">@Localizer["ThemeHighContrast"]</option>
                            </select>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home" asp-action="SetLanguage"
                               asp-route-culture="ru"
                               asp-route-returnUrl="@Context.Request.Path">RU</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home" asp-action="SetLanguage"
                               asp-route-culture="en"
                               asp-route-returnUrl="@Context.Request.Path">EN</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-5 py-3 border-top text-center text-muted small">
        <div class="container">
            <div class="copyright">
                © 2026 <a href="#" onclick="event.preventDefault(); window.IIChatTools.toast.info('RuChating (iilmchat) — AI Chat Platform');">RuChating</a>
                (iilmchat) · IIChatTools v@(AppVersion.Current)
            </div>
        </div>
    </footer>

    <!-- jQuery (локально) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>

    <!-- Bootstrap 5 Bundle (включает Popper, локально) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <!-- KI-122 (B2): модуль тем оформления. Экспортирует getTheme / setTheme /
         getAvailableThemes / clearTheme / watchSystemTheme — используются в B3 (<select>).
         Подключается отдельным тегом (не через main.js): модуль глобальный, не привязан к странице. -->
    <script type="module" src="~/js/modules/theme.js" asp-append-version="true"></script>

    <!-- Точка входа ES-модулей -->
    <script type="module" src="~/js/main.js" asp-append-version="true"></script>

    <!-- KI-122 (B2/B3): следим за системной темой + инициализируем переключатель. -->
    <script type="module">
        import { watchSystemTheme, initThemeSelect } from '/js/modules/theme.js';
        watchSystemTheme();
        initThemeSelect(document.getElementById('theme-select'));
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>