# ============================================================
# IIChatTools — пример .env
# ============================================================
# Скопируйте в .env и заполните своими значениями.
# Файл .env не коммитится (в .gitignore).
#
# © 2026 RuChating (iilmchat) · IIChatTools v1.1.1
# ============================================================

# --- Обязательные ---

# JWT-ключ, минимум 32 символа.
# Сгенерировать случайный (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Maximum 256) }))
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# --- Опциональные ---

# Тег образа для pull/build
IICHATTOOLS_TAG=v1.1.1

# Порт, на котором API доступен снаружи
IICHATTOOLS_PORT=8080

# ASP.NET Core окружение (Development / Production / Staging)
ASPNETCORE_ENVIRONMENT=Production

# Устанавливать Chromium для браузерных инструментов.
# true → +~400 МБ к образу, +1-2 мин сборки
INSTALL_BROWSER=false

# Прокси (если используется)
# IICHATTOOLS_PROXY=http://proxy.local:8080
# IICHATTOOLS_PROXY_USER=user
# IICHATTOOLS_PROXY_PASS=pass

# SQL Server (если раскомментирован блок sqlserver в docker-compose.yml)
# MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# MSSQL_PORT=1433