<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Отключаем стандартный источник, чтобы не было попыток выхода в сеть -->
    <clear />
    <!-- Добавляем нашу локальную папку как источник -->
    <add key="LocalPackages" value="G:\AI\IIChatTools\LocalPackages" />
  </packageSources>
</configuration>