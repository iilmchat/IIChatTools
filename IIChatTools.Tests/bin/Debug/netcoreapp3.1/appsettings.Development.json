{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=IIChatTools_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "Provider": "Sqlite",
    "SqliteConnectionString": "Data Source=Data/iichattools-dev.db"
  },
  "Audit": {
    "ToDatabase": true,
    "ToFile": true
  },
  "Jwt": {
    "Issuer": "IIChatTools",
    "Audience": "IIChatToolsClients",
    "Key": "DEV_ONLY_SECRET_KEY_32_CHARS_MINIMUM_LENGTH_1234",
    "ExpirationMinutes": 480
  },
  "Workspace": {
    "RootPath": "G:\\AI\\IIChatTools\\Workspace",
    "MaxFileSizeBytes": 10485760,
    "MaxCommandOutputBytes": 1048576
  },
  "Security": {
    "EnableCodeExecution": true,
    "EnableBrowserAutomation": true,
    "EnableShellCommands": true,
    "ApprovalExpirationMinutes": 5,
    "GitTimeoutSeconds": 60,
    "GhTimeoutSeconds": 90,

    "BrowserHeadless": true,
    "MaxBrowserSessionsPerUser": 3,
    "BrowserSessionTtlMinutes": 15,
    "BrowserPageTimeoutSeconds": 30        
  },
  "Tools": {
    "RequireApprovalByDefault": true,
    "Whitelist": []
  },
  "LmStudio": {
    "BaseUrl": "http://localhost:8034",
    "Model": "local-model",
    "Temperature": 0.3, 
    "MaxTokens": 4096,
    "RequestTimeoutSeconds": 300
  },
  "SubAgent": {
    "DefaultMaxSteps": 10,
    "MaxStepsLimit": 30,
    "SystemPrompt": "Ты — автономный вторичный агент IIChatTools. Твоя задача — выполнить порученную работу, используя доступные инструменты. Действуй пошагово, проверяй результаты и заверши работу финальным ответом. Отвечай на русском языке. У тебя максимум {{maxSteps}} шагов.",
    "ReviewerSystemPrompt": "Ты — критичный рецензент. Проверь финальный ответ другого агента на полноту и корректность. Если всё в порядке — напиши 'OK' и краткое подтверждение. Если есть замечания — перечисли их по пунктам. Отвечай на русском языке."
  },
  "Browser": {
    "Headless": true,
    "ProxyServer": "http://222.1.20.1:8080",
    "ProxyUsername": "nikiforov",
    "ProxyPassword": "6989",
    "MaxSessionsPerUser": 3,
    "SessionTtlMinutes": 15,
    "PageTimeoutSeconds": 30
  },      
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }

