<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IIChatTools.Tests</RootNamespace>
    <AssemblyName>IIChatTools.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Description>Модульные и интеграционные тесты IIChatTools.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ссылки на проекты -->
    <ProjectReference Include="..\IIChatTools.API\IIChatTools.API.csproj" />
    <ProjectReference Include="..\IIChatTools.Data\IIChatTools.Data.csproj" />
    <ProjectReference Include="..\IIChatTools.Services\IIChatTools.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit + вспомогательные -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Моки -->
    <PackageReference Include="Moq" Version="$(MoqVersion)" />

    <!-- InMemory-провайдер для тестов БД -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EFCoreVersion)" />

    <!-- См. KI-022: переопределение транзитивной зависимости SQLitePCLRaw. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SQLitePCLRawVersion)" />    

    <!-- Для тестов ASP.NET Core (интеграционные) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MicrosoftAspNetCoreVersion)" />
  </ItemGroup>

</Project>