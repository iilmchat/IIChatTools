<Application x:Class="IIChatTools.VisionOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <!--
        StartupUri НЕ задан: стартуем окно вручную из App.OnStartup —
        после того, как распарсим аргументы командной строки и поднимем pipe-сервер.
    -->
    <Application.Resources>
        <!--
            Ресурсы overlay.
            Цвета согласованы с DESIGN § 4.6:
              - фон — полупрозрачный тёмный (чтобы видеть UI под overlay);
              - текст — светлый;
              - STOP — красная кнопка.
        -->
        <SolidColorBrush x:Key="OverlayBackground" Color="#E01E1E1E" />
        <SolidColorBrush x:Key="OverlayForeground" Color="#FFF0F0F0" />
        <SolidColorBrush x:Key="OverlayAccent" Color="#FF4A9EFF" />
        <SolidColorBrush x:Key="OverlayStop" Color="#FFE53935" />
        <SolidColorBrush x:Key="OverlayOk" Color="#FF43A047" />
        <SolidColorBrush x:Key="OverlayWarn" Color="#FFF9A825" />

        <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OverlayForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OverlayHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayTextStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OverlayStop}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC62828" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>