<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IIChatTools.Services</RootNamespace>
    <AssemblyName>IIChatTools.Services</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Description>Бизнес-логика IIChatTools: инструменты, аудит, подтверждения, суб-агенты.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IIChatTools.Data\IIChatTools.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />

    <!-- KI-049: tiktoken-совместимая токенизация для подсчёта токенов.
         Два пакета: API (Microsoft.ML.Tokenizers) + данные BPE-словаря
         (Microsoft.ML.Tokenizers.Data.Cl100kBase). Одной версии. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="$(MLTokenizersVersion)" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="$(MLTokenizersVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />

    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />

    <PackageReference Include="PuppeteerSharp" Version="$(PuppeteerSharpVersion)" />
    <PackageReference Include="HtmlAgilityPack" Version="$(HtmlAgilityPackVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />

    <!-- Prometheus метрики (exporter + HTTP-middleware).
         GA-версия 8.2.1 — совместима с .NET 10. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />

    <!-- v1.7.0 (KI-097): ADO.NET-провайдеры для SqlAgent (SqlConnectionProvider).
         Microsoft.Data.Sqlite — нужен явно: EF Core Sqlite живёт в API, в Services
         транзитивно не приходит. Microsoft.Data.SqlClient — приходит транзитивно
         через Data → EF Core SqlServer, но регистрируем явно (compile-time safety).
         Версия синхронизирована с транзитивной (EF Core SqlServer 10.0.12 → 6.1.6),
         иначе NU1605 (downgrade). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MicrosoftDataSqliteVersion)" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="$(MicrosoftDataSqlClientVersion)" />

    <!-- v1.7.1 (KI-104): парсеры PDF/DOCX для RAG.
         PdfPig — Apache 2.0, извлечение текста (без OCR).
         DocumentFormat.OpenXml — MIT, .docx через OpenXml SDK.
         Оба регистрируются как IRagDocumentParser в Startup.cs. -->
    <PackageReference Include="PdfPig" Version="$(PdfPigVersion)" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="$(OpenXmlVersion)" />

    <!-- v1.7.1 (KI-105): явный override транзитивного System.IO.Packaging 8.0.0
         (тянется DocumentFormat.OpenXml 3.1.0) — две High-уязвимости.
         Явная версия 10.0.0 перебивает транзитивную (прецедент KI-022). -->
    <PackageReference Include="System.IO.Packaging" Version="$(SystemIOPackagingVersion)" />
    <PackageReference Include="MailKit" Version="$(MailKitVersion)" />

    <!-- v1.13.0 (KI-140): Whisper.net — офлайн-распознавание речи.
         Whisper.net — managed API + Whisper.net.Runtime — native libs (CPU). -->
    <PackageReference Include="Whisper.net" Version="$(WhisperNetVersion)" />
    <PackageReference Include="Whisper.net.Runtime" Version="$(WhisperNetVersion)" />

    <!-- v1.12.0 (KI-131): System.Drawing.Common — GDI-скриншоты для
         Vision Agent (LocalHarnessVisionBackend, Ф2).
         Windows-only в рантайме, но TFM = plain net10.0 — не ломает
         Linux-сборку Docker. -->
    <PackageReference Include="System.Drawing.Common" Version="$(SystemDrawingCommonVersion)" />
  </ItemGroup>

</Project>