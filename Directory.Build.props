<Project>

  <!--
    Общие свойства MSBuild для всех проектов IIChatTools.
    Позволяет избежать дублирования метаданных и версий пакетов в каждом .csproj.
    © 2026 RuChating (iilmchat) · IIChatTools v1.12.0
  -->
  <PropertyGroup>
    <!-- Метаданные продукта -->
    <Company>RuChating (iilmchat)</Company>
    <Product>IIChatTools</Product>
    <Version>1.12.0</Version>
    <Copyright>© 2026 RuChating (iilmchat) · IIChatTools v1.12.0</Copyright>
    <Authors>RuChating</Authors>

    <!-- Настройки компилятора -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      Единые версии пакетов.
      Используются через $(EFCoreVersion) и т.п. в .csproj.
      Все версии синхронизированы с .NET 10 LTS (10.0.x).
    -->
    <!-- Версии Microsoft-пакетов синхронизированы с ref-pack SDK 10.0.401 (10.0.12).
         Это критично для Microsoft.AspNetCore.RateLimiting: DLL живёт только
         в shared framework, и при mismatch версий не резолвится. -->
    <EFCoreVersion>10.0.12</EFCoreVersion>
    <EntityFrameworkSqliteVersion>10.0.12</EntityFrameworkSqliteVersion>
    <MicrosoftAspNetCoreVersion>10.0.12</MicrosoftAspNetCoreVersion>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
    <IdentityModelVersion>8.14.0</IdentityModelVersion>
    <NewtonsoftJsonVersion>13.0.3</NewtonsoftJsonVersion>
    <HtmlAgilityPackVersion>1.12.1</HtmlAgilityPackVersion>
    <PuppeteerSharpVersion>7.1.0</PuppeteerSharpVersion>
    <!-- v1.7.0 (KI-097): ADO.NET-провайдеры для SqlAgent (Database Agent). -->
    <!-- Microsoft.Data.Sqlite — низкоуровневый SqliteConnection (не EF-обёртка). -->
    <!-- Microsoft.Data.SqlClient — ADO.NET SqlConnection для SqlServer. -->
    <!-- ВАЖНО: версия SqlClient должна быть >= транзитивной версии EF Core SqlServer 10.0.12 (6.1.6). -->
    <!-- Младшая версия = NU1605 (downgrade). Синхронизировать при апдейте EF Core. -->
    <MicrosoftDataSqliteVersion>10.0.12</MicrosoftDataSqliteVersion>
    <MicrosoftDataSqlClientVersion>6.1.6</MicrosoftDataSqlClientVersion>
    <!-- KI-049: токенизация для подсчёта tokensIn/Out (tiktoken-совместимый). -->
    <!-- ВАЖНО: два пакета — API + Data.Cl100kBase (словарь), одной версии. -->
    <MLTokenizersVersion>1.0.0</MLTokenizersVersion>
    <XunitVersion>2.9.2</XunitVersion>
    <XunitRunnerVisualStudioVersion>2.8.2</XunitRunnerVisualStudioVersion>
    <MoqVersion>4.20.72</MoqVersion>
    <!--
      SQLitePCLRaw: явная версия для устранения GHSA-2m69-gcr7-jv3q (KI-022).
      Ветка 2.1.x — совместима с EF Core Sqlite 10.0.4.
      Источник: Directory.Build.props, значение используется в PackageReference.
    -->
    <SQLitePCLRawVersion>2.1.13</SQLitePCLRawVersion>

    <!-- v1.7.1 (KI-104): парсеры PDF/DOCX для RAG.
         PdfPig — Apache 2.0, ~500 KB, извлечение текста из PDF.
         DocumentFormat.OpenXml — MIT, ~1.5 MB, .docx через OpenXml SDK. -->
    <PdfPigVersion>0.1.9</PdfPigVersion>
    <OpenXmlVersion>3.1.0</OpenXmlVersion>

    <!-- v1.7.1 (KI-105): явный override транзитивного пакета
         System.IO.Packaging 8.0.0 (тянется DocumentFormat.OpenXml 3.1.0).
         Уязвимости GHSA-f32c-w444-8ppv / GHSA-qj66-m88j-hmgj (High).
         Прецедент — KI-022 (SQLitePCLRaw 2.1.11 → 2.1.13).
         Версия 10.0.0 — соответствует .NET 10 SDK (10.0.401). -->
    <SystemIOPackagingVersion>10.0.0</SystemIOPackagingVersion>
    <!-- v1.9.0-followup (KI-125): 4.8.0 -> 4.18.1.
         Патчит 2 Moderate advisory:
         - GHSA-9j88-vvj5-vhgr (MailKit, STARTTLS response injection) — fixed 4.16.0.
         - GHSA-g7hc-96xr-gvvx (MimeKit, CRLF injection) — fixed 4.15.1.
         MimeKit подтягивается транзитивно на ту же версию. -->
    <MailKitVersion>4.18.1</MailKitVersion>

    <!-- v1.13.0 (KI-140): Whisper.net — офлайн-распознавание речи.
         Whisper.net — managed API (MIT). Whisper.net.Runtime — native whisper.cpp.
         Оба пакета — одной версии. См. DESIGN_SPEECH_RECOGNITION.md § 3.1. -->
    <WhisperNetVersion>1.8.1</WhisperNetVersion>

    <!-- v1.12.0 (KI-131): System.Drawing.Common — GDI-скриншоты для
         LocalHarnessVisionBackend (computer-use pattern). Windows-only в рантайме
         (Microsoft deprecation .NET 7+), но TFM = plain net10.0 — совместимо
         с Linux-сборкой Docker (метод бросит PlatformNotSupportedException,
         что допустимо — backend всё равно требует Windows).
         См. DESIGN_VISION_AGENT.md § 7.2. -->
    <SystemDrawingCommonVersion>10.0.0</SystemDrawingCommonVersion>
  </PropertyGroup>

</Project>