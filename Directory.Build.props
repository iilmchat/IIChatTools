<Project>

  <!--
    Общие свойства MSBuild для всех проектов решения IIChatTools.
    Позволяет избежать дублирования метаданных и версий пакетов в каждом .csproj.
    © 2026 RuChating (iilmchat) · IIChatTools v1.0
  -->
  <PropertyGroup>
    <!-- Метаданные продукта -->
    <Company>RuChating (iilmchat)</Company>
    <Product>IIChatTools</Product>
    <Version>1.0.2</Version>
    <Copyright>© 2026 RuChating (iilmchat) · IIChatTools v1.0.2</Copyright>
    <Authors>RuChating</Authors>

    <!-- Настройки компилятора -->
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Единые версии пакетов (используются через $(EFCoreVersion) и т.п. в .csproj) -->
    <EFCoreVersion>3.1.32</EFCoreVersion>
    <EntityFrameworkSqliteVersion>3.1.32</EntityFrameworkSqliteVersion>    
    <MicrosoftAspNetCoreVersion>3.1.32</MicrosoftAspNetCoreVersion>
    <MicrosoftExtensionsVersion>3.1.32</MicrosoftExtensionsVersion>
    <IdentityModelVersion>6.35.0</IdentityModelVersion>
    <NewtonsoftJsonVersion>13.0.3</NewtonsoftJsonVersion>
    <HtmlAgilityPackVersion>1.11.61</HtmlAgilityPackVersion>
    <PuppeteerSharpVersion>2.0.4</PuppeteerSharpVersion>
    <XunitVersion>2.7.0</XunitVersion>
    <MoqVersion>4.20.70</MoqVersion>



    <RuntimeNativeOpenSslVersion>4.3.0</RuntimeNativeOpenSslVersion>    
    <PuppeteerSharpVersion>7.1.0</PuppeteerSharpVersion>
  </PropertyGroup>

</Project>