# Нормализация переводов строк: LF в репозитории для всех текстовых файлов.
# Исключает предупреждения Git при checkout на Windows.
# © 2026 RuChating (iilmchat) · IIChatTools v1.1.0

* text=auto eol=lf

# Явно текстовые
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.resx      text eol=lf
*.cshtml    text eol=lf
*.razor     text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ps1       text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf

# Бинарные — не трогать
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.gz    binary
*.dll   binary
*.exe   binary
*.nupkg binary
*.snk   binary
*.pfx   binary